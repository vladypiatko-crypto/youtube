    { "start": 5.4, "end": 8.6, "text": "Every night for forty years, he climbed the same 212 steps." },
    { "start": 8.9, "end": 11.8, "text": "One light. One job. Keep the ships off the rocks." },
    { "start": 12.3, "end": 15.2, "text": "Then came the storm of '61." },
    { "start": 15.5, "end": 17.8, "text": "The power died. The lamp did not." },
    { "start": 18.6, "end": 21.6, "text": "By morning, every boat was home." }
